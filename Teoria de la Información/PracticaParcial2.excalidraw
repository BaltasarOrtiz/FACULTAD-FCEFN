    {
      "id": "zGeBqjiQhDHzF2pTFdl7x",
      "type": "text",
      "x": 262.909423828125,
      "y": 1089.5,
      "width": 646.0006103515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
