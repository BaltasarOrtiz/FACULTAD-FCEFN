      "seed": 695748457,
      "version": 1079,
      "versionNonce": 2091701237,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794427424912,
      "created": 1794425893805,
      "link": null,
      "locked": false,
      "text": "17 · 33 = 561 -> 561/40 = 14.025\n                 -> 40*14 + 1 ≡ 1 mod(40)\n\n",
      "fontSize": 43.50239847193209,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "17 · 33 = 561 -> 561/40 = 14.025\n                 -> 40*14 + 1 ≡ 1 mod(40)\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pM2UWAQfYxmbfQqefMxTG",
      "type": "text",
      "x": 7231.6245984755615,
      "y": 6721.156804060454,
      "width": 924.4031993970325,
      "height": 76.97847294776278,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDA",
      "roundness": null,
