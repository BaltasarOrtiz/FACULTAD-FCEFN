      "locked": false,
      "text": "se llega hasta 17^8 porque otro square mas daria 16\nque se pasa del exponente de 15 de la formula del paso 3",
      "fontSize": 43.50239847193209,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "se llega hasta 17^8 porque otro square mas daria 16\nque se pasa del exponente de 15 de la formula del paso 3",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
