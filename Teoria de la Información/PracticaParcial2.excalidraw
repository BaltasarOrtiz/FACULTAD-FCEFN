      "type": "text",
      "x": 7280.28094998678,
      "y": 6836.930912816617,
      "width": 878.8471069335938,
      "height": 54.37799808991511,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
