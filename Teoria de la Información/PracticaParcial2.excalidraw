    {
      "id": "7DW3rJfAuLt4BqiXKWrPA",
      "type": "text",
      "x": 3076.6380482022737,
      "y": 553.8010351356861,
      "width": 189.35008239746094,
      "height": 78.05093204302119,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4t",
      "roundness": null,
      "seed": 1794935953,
      "version": 237,
      "versionNonce": 880485265,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162655357,
      "created": 1794162625718,
      "link": null,
      "locked": false,
      "text": "Datos : \nn=12 \nh(x)= x^3+x^2+x+1",
      "fontSize": 20.813581878138983,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Datos : \nn=12 \nh(x)= x^3+x^2+x+1",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "iex-Bh-oBj63xgpiq-N4m",
      "type": "text",
      "x": 3356.638048202274,
      "y": 550.4677018023525,
      "width": 800,
      "height": 130.08488673836865,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4u",
      "roundness": null,
      "seed": 222985137,
      "version": 560,
      "versionNonce": 1694240401,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162782552,
      "created": 1794162672343,
      "link": null,
      "locked": false,
      "text": "en este ejercicio tenemos el polinomio chekeador no el generador, por lo tanto \n\ng(x) * h(x) = x^n + 1 osea si te dan una la otra sale dividiendo\n\nlos otros grados de g=n-k y h=k se complementan",
      "fontSize": 20.813581878138983,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "en este ejercicio tenemos el polinomio chekeador no el generador, por lo tanto \n\ng(x) * h(x) = x^n + 1 osea si te dan una la otra sale dividiendo\n\nlos otros grados de g=n-k y h=k se complementan",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P53Me3SOxzoQlCPi13y2B",
      "type": "text",
      "x": 3054.063492063494,
      "y": 1082.8650793650786,
      "width": 350.13983154296875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4w",
      "roundness": null,
      "seed": 171961457,
      "version": 155,
      "versionNonce": 1670159519,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "s8oDWRbCPn3Wvfj2r-bqn",
          "type": "arrow"
        }
      ],
      "updated": 1794163267210,
      "created": 1794162928565,
      "link": null,
      "locked": false,
      "text": "nosotros sabemos que g * h = x^12:\n\ng(x) = ( x^12 + 1 ) / h(x)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "nosotros sabemos que g * h = x^12:\n\ng(x) = ( x^12 + 1 ) / h(x)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
