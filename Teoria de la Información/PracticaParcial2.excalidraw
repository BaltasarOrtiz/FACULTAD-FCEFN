      "isDeleted": false,
      "boundElements": [],
      "updated": 1794427617951,
      "created": 1794425893805,
      "link": null,
      "locked": false,
      "text": "M = a⁻¹·(C − b) mod N = 33·(C − 7) mod 40",
      "fontSize": 43.50239847193209,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "M = a⁻¹·(C − b) mod N = 33·(C − 7) mod 40",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
