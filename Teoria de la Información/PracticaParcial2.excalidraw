      "isDeleted": false,
      "boundElements": [],
      "updated": 1794090120644,
      "created": 1794090115807,
      "link": null,
      "locked": false,
      "text": "Se pasa la letra a número, se resta 9, se multiplica por 37 y se reduce módulo 40 (si c − 9 da negativo, el\nproducto negativo se suma de a 40 hasta caer en 0…39).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
