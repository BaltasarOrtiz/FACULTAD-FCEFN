      "link": null,
      "locked": false,
      "text": "Si el cifrado es C = a·m + b (mod n), el descifrado queda m = a⁻¹·(C − b).\nDistribuyendo:",
      "fontSize": 47.020476646054206,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si el cifrado es C = a·m + b (mod n), el descifrado queda m = a⁻¹·(C − b). Distribuyendo:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
