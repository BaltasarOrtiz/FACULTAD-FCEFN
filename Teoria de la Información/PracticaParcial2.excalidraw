      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sí, pero solo bajo un supuesto. El código detecta que hay un error, y no sabe en qué dígito está.",
