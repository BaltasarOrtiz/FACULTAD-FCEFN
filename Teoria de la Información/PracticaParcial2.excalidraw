      "versionNonce": 725634371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794088965719,
      "created": 1794088199966,
      "link": null,
      "locked": false,
      "text": "Cómo armarlo, paso a paso:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
