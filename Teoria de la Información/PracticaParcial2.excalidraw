    },
    {
      "id": "ZTQm4mcSrltGGY72M_Vf-",
      "type": "text",
      "x": 2966.3480431903763,
      "y": 7106.874599593095,
      "width": 258.4596252441406,
      "height": 143.09291071510103,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBM",
      "roundness": null,
      "seed": 549567983,
      "version": 309,
      "versionNonce": 2035463919,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794169760607,
      "created": 1794169629016,
      "link": null,
      "locked": false,
      "text": "a⁻¹ = a^(φ(N)−1) mod N \n    = 3^(16−1) mod 40 \n    = 13¹⁵ mod 40\n\n",
      "fontSize": 22.894865714416163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
