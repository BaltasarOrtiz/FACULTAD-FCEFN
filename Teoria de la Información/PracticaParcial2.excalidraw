    {
      "id": "_E5gh7u8I2s_dtwDyz08-",
      "type": "text",
      "x": 555.9433748851051,
      "y": 10024.170895714842,
      "width": 561.4996337890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
