      "frameId": null,
      "index": "bCq",
      "roundness": null,
      "seed": 1092629449,
      "version": 793,
      "versionNonce": 1623133673,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794425737125,
      "created": 1794425658432,
      "link": null,
      "locked": false,
      "text": "Contarlos da φ(40): hay 16 elementos, así que φ(40) = 16.",
      "fontSize": 46.25033490491124,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contarlos da φ(40): hay 16 elementos, así que φ(40) = 16.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qQKtbn2TNtx2_EFJhoMm3",
      "type": "text",
      "x": 9947.260309792091,
      "y": 4789.239911634009,
      "width": 1673.8933121408359,
      "height": 115.62583726227811,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCr",
      "roundness": null,
      "seed": 1079562921,
      "version": 754,
      "versionNonce": 1492115751,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794425737125,
      "created": 1794425658432,
      "link": null,
      "locked": false,
      "text": "Chequeo con la fórmula: 40·(1 − ½)·(1 − ⅕) = 40·½·⅘ = 16 ✔ coincide con el\nconteo.",
      "fontSize": 46.25033490491124,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chequeo con la fórmula: 40·(1 − ½)·(1 − ⅕) = 40·½·⅘ = 16 ✔ coincide con el conteo.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LJrcu_HedjcM1lnmuHnC7",
      "type": "text",
      "x": 9941.947585318354,
      "y": 4927.185900565114,
      "width": 1798.9981532835584,
      "height": 173.43875589341715,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCs",
      "roundness": null,
      "seed": 1356502409,
      "version": 780,
      "versionNonce": 1465346249,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794425737125,
      "created": 1794425658432,
      "link": null,
      "locked": false,
      "text": "Chequeo contando lo tachado: de los 39 números, hay 19 pares, 7 múltiplos de 5\n(5, 10, …, 35) y 3 múltiplos de ambos (10, 20, 30, que se contaron dos veces).\nTachados: 19 + 7 − 3 = 23, y 39 − 23 = 16 ✔.",
      "fontSize": 46.25033490491124,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chequeo contando lo tachado: de los 39 números, hay 19 pares, 7 múltiplos de 5 (5, 10, …, 35) y 3 múltiplos de ambos (10, 20, 30, que se contaron dos veces). Tachados: 19 + 7 − 3 = 23, y 39 − 23 = 16 ✔.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
