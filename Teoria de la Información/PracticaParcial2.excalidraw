      "link": null,
      "locked": false,
      "text": "a⁻¹ = a^(φ(N)−1) mod N \n    = 17^(16−1) mod 40 \n    = 17¹⁵ mod 40\n\n",
      "fontSize": 72.83982312265228,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a⁻¹ = a^(φ(N)−1) mod N \n    = 17^(16−1) mod 40 \n    = 17¹⁵ mod 40\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
