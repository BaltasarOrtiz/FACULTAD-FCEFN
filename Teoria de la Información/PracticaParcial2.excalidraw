    {
      "id": "dHV1cqdIy8nI052mYZ0P3",
      "type": "text",
      "x": 305.3752765279452,
      "y": 6728.0117298212635,
      "width": 275.4997863769531,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b35",
      "roundness": null,
      "seed": 665461539,
      "version": 195,
      "versionNonce": 218760269,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794086357113,
      "created": 1794086350963,
      "link": null,
      "locked": false,
      "text": "Reconocer y corregir errores",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconocer y corregir errores",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jKqJxks14dtDhmpIc2rGn",
      "type": "text",
      "x": 276.9075715434792,
      "y": 6812.357959831985,
      "width": 1177.1518272403703,
      "height": 225,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36",
      "roundness": null,
      "seed": 573412547,
      "version": 1113,
      "versionNonce": 469026467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794086589564,
      "created": 1794086392264,
      "link": null,
      "locked": false,
      "text": "Capo es sencillo esto:\n\n1- Sindromes: C1 XOR I , C2 XOR I. Estos indican en que posicion de la fila esta el error\n2- Paridad de c/fila: indica que fila tiene una cantidad impar de errores\n3- Paridad de c/columna: indica que columna tiene errores\n\n+ El error esta en el cruce de la fila y la columna que fallan, igual que en el codigo rectangular\n+ Si hay 2 errores en la misma fila, el hamming de esa fila puede equivocarse y la paridad de fila no lo nota\n+ Las partidades de columna son las que detectan",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capo es sencillo esto:\n\n1- Sindromes: C1 XOR I , C2 XOR I. Estos indican en que posicion de la fila esta el error\n2- Paridad de c/fila: indica que fila tiene una cantidad impar de errores\n3- Paridad de c/columna: indica que columna tiene errores\n\n+ El error esta en el cruce de la fila y la columna que fallan, igual que en el codigo rectangular\n+ Si hay 2 errores en la misma fila, el hamming de esa fila puede equivocarse y la paridad de fila no lo nota\n+ Las partidades de columna son las que detectan",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
