      "link": null,
      "locked": false,
      "text": "Corrección: dmin ≥ 2t + 1 → t = ⌊(6 − 1)/2⌋ = 2. Corrige hasta 2 errores.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Corrección: dmin ≥ 2t + 1 → t = ⌊(6 − 1)/2⌋ = 2. Corrige hasta 2 errores.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
