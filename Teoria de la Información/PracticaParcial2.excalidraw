      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "rXLQfhMXbzQV15VLD14MA",
      "type": "text",
      "x": 272.5301985466892,
      "y": 11189.610268952121,
      "width": 1044.4594463075446,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
      "roundness": null,
      "seed": 477182637,
      "version": 186,
      "versionNonce": 1460550787,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794090120644,
      "created": 1794090115807,
      "link": null,
      "locked": false,
      "text": "Se pasa la letra a número, se resta 9, se multiplica por 37 y se reduce módulo 40 (si c − 9 da negativo, el\nproducto negativo se suma de a 40 hasta caer en 0…39).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se pasa la letra a número, se resta 9, se multiplica por 37 y se reduce módulo 40 (si c − 9 da negativo, el producto negativo se suma de a 40 hasta caer en 0…39).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
