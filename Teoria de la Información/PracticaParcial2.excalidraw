      "created": 1794077147368,
      "link": null,
      "locked": false,
      "text": "obtencion del polinomio generador g(x) para calculo de la distancia minima\ny capacidad del codigo",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
