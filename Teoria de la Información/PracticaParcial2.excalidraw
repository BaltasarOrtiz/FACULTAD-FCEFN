      "isDeleted": true,
      "boundElements": [],
      "updated": 1794086902415,
      "created": 1794086625459,
      "link": null,
      "locked": false,
      "text": "se revisan todas las verificaciones:\n\nfila 0: C1 = 1, C2=0 I=0 , resultado: 0 por lo tanto no cumple\nfila 1: C1 = 1, I=0 entonces S1=1, resultado: 0 por lo tanto no cumple",
      "fontSize": 20,
      "baseFontSize": null,
