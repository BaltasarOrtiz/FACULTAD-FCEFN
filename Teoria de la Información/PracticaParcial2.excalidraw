      "type": "text",
      "x": 7256.652175927183,
      "y": 6445.938882922958,
      "width": 1090.000383013488,
      "height": 217.51199235966044,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD9",
