    {
      "id": "rXLQfhMXbzQV15VLD14MA",
      "type": "text",
      "x": 272.5301985466892,
      "y": 11189.610268952121,
      "width": 1044.4594463075446,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Z",
