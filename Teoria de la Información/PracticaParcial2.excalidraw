      "created": 1794163290557,
      "link": null,
      "locked": false,
      "text": "Se usa V(x) = i(x) · g(x). La información i tiene 3 bits, así que i(x) tiene grado 2\no menos. Escribo g con 12 bits: 110011001100.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se usa V(x) = i(x) · g(x). La información i tiene 3 bits, así que i(x) tiene grado 2 o menos. Escribo g con 12 bits: 110011001100.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
