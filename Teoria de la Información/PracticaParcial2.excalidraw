    {
      "id": "cchTD77dQQwKpiLgV0DvT",
      "type": "text",
      "x": 284.3955049302027,
      "y": 6563.065721838986,
      "width": 1091.8988343506549,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b33",
      "roundness": null,
      "seed": 1926686349,
      "version": 351,
      "versionNonce": 1796033837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794086290398,
      "created": 1794086171481,
      "link": null,
      "locked": false,
      "text": "Detector:  dmin-1 = 7 - 1 = 6.        Es decir detecta 6 errores\nCorrector:  [(7-1)/2] = 3.       Es decir corrige hasta 3 errores\nOpcional: podemos decir que corrige hasta 3 errores en simultaneo y en si puede detectar otros 3 errores mas",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Detector:  dmin-1 = 7 - 1 = 6.        Es decir detecta 6 errores\nCorrector:  [(7-1)/2] = 3.       Es decir corrige hasta 3 errores\nOpcional: podemos decir que corrige hasta 3 errores en simultaneo y en si puede detectar otros 3 errores mas",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
