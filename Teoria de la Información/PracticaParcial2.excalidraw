      "updated": 1794169615007,
      "created": 1794089164040,
      "link": null,
      "locked": false,
      "text": "a⁻¹ = a^(φ(N)−1) mod N \n    = 13^(16−1) mod 40 \n    = 13¹⁵ mod 40\n\n",
      "fontSize": 22.894865714416163,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a⁻¹ = a^(φ(N)−1) mod N \n    = 13^(16−1) mod 40 \n    = 13¹⁵ mod 40\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
