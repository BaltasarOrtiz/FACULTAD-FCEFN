    {
      "id": "Xf8ohrMqj1ZOLqA5E8PR2",
      "type": "text",
      "x": 3045.3888888888896,
      "y": 856.2103174603175,
      "width": 636.129025149935,
      "height": 135.0848867383687,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4r",
      "roundness": null,
      "seed": 733454703,
      "version": 442,
      "versionNonce": 568795457,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794162907252,
      "created": 1794162465067,
      "link": null,
      "locked": false,
      "text": "como h(x) es de grado 3, entonces k=3\n\npor lo tanto nos queda que el codigo es (12,3)\n\nesto nos da 2^3= 8 palabras validad y n-k = 9 chequeadores",
      "fontSize": 21.613581878139,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "como h(x) es de grado 3, entonces k=3\n\npor lo tanto nos queda que el codigo es (12,3)\n\nesto nos da 2^3= 8 palabras validad y n-k = 9 chequeadores",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
