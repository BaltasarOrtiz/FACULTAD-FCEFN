      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hFEgP13k_yh9HD03iwaoV",
      "type": "text",
      "x": 248.1111111111111,
      "y": 907,
      "width": 919.4196166992189,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1223703747,
      "version": 211,
      "versionNonce": 1258387477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794435954960,
      "created": 1794077240494,
      "link": null,
      "locked": false,
      "text": "En un código lineal, dmin = el peso mínimo de las palabras no nulas (peso = cantidad de 1).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En un código lineal, dmin = el peso mínimo de las palabras no nulas (peso = cantidad de 1).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mJ1sCfcheO2gYYbjGhZFq",
      "type": "text",
      "x": 248.1111111111111,
      "y": 945.5,
      "width": 749.33935546875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1633907437,
      "version": 69,
      "versionNonce": 1303849077,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794435955506,
      "created": 1794077270398,
      "link": null,
      "locked": false,
      "text": "Esto vale porque la suma (XOR) de dos palabras válidas también es válida.\nEntonces la distancia entre dos palabras equivale al peso de otra palabra del\ncódigo.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Esto vale porque la suma (XOR) de dos palabras válidas también es válida. Entonces la distancia entre dos palabras equivale al peso de otra palabra del código.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
