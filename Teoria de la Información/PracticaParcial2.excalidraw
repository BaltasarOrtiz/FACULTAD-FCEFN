      "updated": 1794169432758,
      "created": 1794169328144,
      "link": null,
      "locked": false,
      "text": "Conclusión: 3 y 29 son coprimos, así que existe 3⁻¹ mod 29 y se sigue con el paso 2.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conclusión: 3 y 29 son coprimos, así que existe 3⁻¹ mod 29 y se sigue con el paso 2.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SrNYsMQMDUwCrfYLlZg0q",
      "type": "text",
      "x": 2961.0062876450365,
      "y": 6872.595154156383,
      "width": 481.2413635253906,
