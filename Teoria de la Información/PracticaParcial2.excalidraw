    {
      "id": "DxF_RD7rR1JVpqPIG-8Oy",
      "type": "text",
      "x": 9932.427849954614,
      "y": 4709.10684133404,
      "width": 1298.477305586458,
      "height": 57.812918631139055,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
