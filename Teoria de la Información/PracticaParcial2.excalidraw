    {
      "id": "k7pJKspM7D8bHEV9nfpB3",
      "type": "text",
      "x": 3016.4153505699865,
      "y": 2970.143777998797,
      "width": 757.6317749023438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8d",
      "roundness": null,
      "seed": 1365218753,
      "version": 126,
      "versionNonce": 1947700175,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794165706068,
      "created": 1794165695648,
      "link": null,
      "locked": false,
      "text": "Error triple: el síndrome no coincide con ninguna fila de Hᵀ ni con el XOR de\ndos filas, así que el decodificador no corrige y pide retransmisión.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Error triple: el síndrome no coincide con ninguna fila de Hᵀ ni con el XOR de dos filas, así que el decodificador no corrige y pide retransmisión.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nAgvrWJsD5Q-WuvjT-kWM",
      "type": "text",
      "x": 3021.3379212351088,
      "y": 3028.9974951076424,
      "width": 752.3717651367188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8e",
      "roundness": null,
      "seed": 643719887,
      "version": 142,
      "versionNonce": 1043842127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794165746467,
      "created": 1794165695648,
      "link": null,
      "locked": false,
      "text": "Si comparás con las filas de Hᵀ, el síndrome puede coincidir con el XOR de dos\ngrupos distintos de tres filas.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si comparás con las filas de Hᵀ, el síndrome puede coincidir con el XOR de dos grupos distintos de tres filas.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
