    {
      "id": "fgqfbt4-EIy1S-UPXFENt",
      "type": "text",
      "x": 288.70012216780333,
      "y": 12195.722918410618,
      "width": 840.7540810251911,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
