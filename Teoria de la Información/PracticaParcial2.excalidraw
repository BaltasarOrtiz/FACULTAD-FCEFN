    {
      "id": "7DW3rJfAuLt4BqiXKWrPA",
      "type": "text",
      "x": 3076.6380482022737,
      "y": 553.8010351356861,
      "width": 189.35008239746094,
      "height": 78.05093204302119,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
