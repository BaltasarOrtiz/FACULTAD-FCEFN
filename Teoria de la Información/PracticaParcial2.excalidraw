      "created": 1794162928565,
      "link": null,
      "locked": false,
      "text": "nosotros sabemos que g * h = x^12:\n\ng(x) = ( x^12 + 1 ) / h(x)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "nosotros sabemos que g * h = x^12:\n\ng(x) = ( x^12 + 1 ) / h(x)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
