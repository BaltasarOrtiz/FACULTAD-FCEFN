    {
      "id": "ub1MTli8_rK9imstz0qAB",
      "type": "text",
      "x": 1808.0208446353101,
      "y": 9399.57236604744,
      "width": 799.45263671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
