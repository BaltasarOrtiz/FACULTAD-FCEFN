      "link": null,
      "locked": false,
      "text": "Equivale a D(c) = 37·c + b' con b' = −37·9 = −333 ≡ 27 (mod 40).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Equivale a D(c) = 37·c + b' con b' = −37·9 = −333 ≡ 27 (mod 40).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
