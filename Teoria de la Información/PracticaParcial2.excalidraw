      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 2123509955,
      "version": 591,
      "versionNonce": 1914057027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794088395545,
      "created": 1794088281560,
      "link": null,
      "locked": false,
      "text": "Paso 2: ¿N es primo? 29 no es divisible por 2, 3 ni 5 (√29 ≈ 5,4), así que es primo.\nEntonces se puede usar N − 1:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Paso 2: ¿N es primo? 29 no es divisible por 2, 3 ni 5 (√29 ≈ 5,4), así que es primo. Entonces se puede usar N − 1:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kTVPg_KoIbkSjYKyAiBpc",
      "type": "text",
      "x": 1811.5517339780479,
      "y": 9463.28015058974,
      "width": 198.33993530273438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3z",
      "roundness": null,
      "seed": 259551469,
      "version": 642,
      "versionNonce": 1801785571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794088395545,
      "created": 1794088281560,
      "link": null,
      "locked": false,
      "text": "φ(29) = 29 − 1 = 28",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "φ(29) = 29 − 1 = 28",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0KHHDiDHUur3bpPv0_EUn",
      "type": "text",
      "x": 1813.0472086043326,
      "y": 9511.38404286089,
      "width": 736.087646484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b40",
      "roundness": null,
      "seed": 389357667,
      "version": 637,
      "versionNonce": 49740931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794088395545,
      "created": 1794088281560,
      "link": null,
      "locked": false,
      "text": "Paso 3: fórmula. a⁻¹ = a^(φ−1) mod N = 3²⁷ mod 29 (exponente 28 − 1 = 27).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Paso 3: fórmula. a⁻¹ = a^(φ−1) mod N = 3²⁷ mod 29 (exponente 28 − 1 = 27).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "X9lY4jblsO5vfw_vtczTE",
      "type": "text",
      "x": 1804.0971770367544,
      "y": 9344.48003349316,
      "width": 160.09447649733798,
      "height": 44.04009367726044,
