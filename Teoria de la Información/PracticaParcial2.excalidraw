      "locked": false,
      "text": "Equivale a D(c) = 37·c + b' con b' = −37·9 = −333 ≡ 27 (mod 40).",
      "fontSize": 43.50239847193209,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Equivale a D(c) = 37·c + b' con b' = −37·9 = −333 ≡ 27 (mod 40).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TIuCMfGwB8XILGc0RW9BU",
      "type": "text",
