      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La regla es calcular los cuadrados sucesivos y, al final, multiplicar solo los que corresponden a bits en 1.",
