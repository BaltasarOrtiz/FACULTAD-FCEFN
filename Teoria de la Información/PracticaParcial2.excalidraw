      "isDeleted": false,
      "boundElements": [],
      "updated": 1794168528705,
      "created": 1794168439181,
      "link": null,
      "locked": false,
      "text": "Buscamos un valor que sea 7 cuando le\nhacemos mod 11, probamos\n\n6 * 1 = 6 -> 6 mod 11 = 6\n6 * 2 = 12 -> 12 mod 11 = 1\n6 * 3 = 18 -> 18 mod 11 = 7",
      "fontSize": 35.06827245570021,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Buscamos un valor que sea 7 cuando le hacemos mod 11, probamos\n\n6 * 1 = 6 -> 6 mod 11 = 6\n6 * 2 = 12 -> 12 mod 11 = 1\n6 * 3 = 18 -> 18 mod 11 = 7",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
