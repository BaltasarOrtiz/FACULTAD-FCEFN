    {
      "id": "52mFSL1zDIfTJfBUAkXjK",
      "type": "text",
      "x": 282.62080629536206,
      "y": 8144.45521801643,
      "width": 779.8394165039062,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 1740231917,
      "version": 99,
      "versionNonce": 1313928141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794087096060,
      "created": 1794087089468,
      "link": null,
      "locked": false,
      "text": "Con un solo error fallaría una fila y una columna que se cruzan; acá no pasa eso,\nasí que hay más de un error. Cómo se corrige (a la palabra válida más cercana, a\ndistancia 3)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con un solo error fallaría una fila y una columna que se cruzan; acá no pasa eso, así que hay más de un error. Cómo se corrige (a la palabra válida más cercana, a distancia 3)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PAort0ENwh-ul9ONMTlM9",
      "type": "text",
      "x": 282.3877645547077,
      "y": 8078.214668128312,
      "width": 794.259521484375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 1934279075,
      "version": 39,
      "versionNonce": 1938599021,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794087255923,
      "created": 1794087094692,
      "link": null,
      "locked": false,
      "text": "La palabra no es válida. Fallan 4 chequeos: el Hamming de la fila 0, la paridad de la\nfila 1 y las paridades de las columnas 2 y 3.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La palabra no es válida. Fallan 4 chequeos: el Hamming de la fila 0, la paridad de la fila 1 y las paridades de las columnas 2 y 3.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
