      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Paso 2 · ¿N es primo? Calcular φ(N)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EMIxK4QBfux2etRuKObFL",
      "type": "text",
      "x": 3055.089052613898,
      "y": 6924.236113139556,
      "width": 799.45263671875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBF",
      "roundness": null,
      "seed": 1228385857,
      "version": 907,
      "versionNonce": 2008774261,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "h1O1969dUPGFPBCRocFUx",
          "type": "arrow"
        }
      ],
      "updated": 1794421235530,
      "created": 1794169468106,
      "link": null,
      "locked": false,
      "text": "29 no es divisible por 2, 3 ni 5 (√29 ≈ 5,4), así que es primo. Entonces se puede\nusar φ(N) = N − 1:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "29 no es divisible por 2, 3 ni 5 (√29 ≈ 5,4), así que es primo. Entonces se puede usar φ(N) = N − 1:",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zt30JH4DH4LILOGLRpWPV",
      "type": "text",
      "x": 3067.9540480035444,
      "y": 6987.838648185053,
      "width": 198.33993530273438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBG",
      "roundness": null,
      "seed": 629816865,
      "version": 955,
      "versionNonce": 21608475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794421211650,
      "created": 1794169468106,
      "link": null,
      "locked": false,
      "text": "φ(29) = 29 − 1 = 28",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "φ(29) = 29 − 1 = 28",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
