      "isDeleted": false,
      "boundElements": [],
      "updated": 1791836600474,
      "created": 1791836414516,
      "link": null,
      "locked": false,
      "text": "                     = 1 + 0.9 * log2(0.9) + (0.1) * log2 (0.1) = 0.531",
      "fontSize": 132,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                     = 1 + 0.9 * log2(0.9) + (0.1) * log2 (0.1) = 0.531",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
