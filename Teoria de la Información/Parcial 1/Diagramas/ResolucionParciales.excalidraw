      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eZydh3iMMe-l2fGYwgAdh",
      "type": "text",
      "x": 445.5970839492892,
      "y": 6337.5670539886105,
      "width": 106.03994750976562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
