      "seed": 2070741231,
      "version": 68,
      "versionNonce": 277157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791507639463,
      "created": 1791398333500,
      "link": null,
      "locked": false,
      "text": "p(i) = p(o) = p(u) = p(e) = 1/6",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "p(i) = p(o) = p(u) = p(e) = 1/6",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RJLTeAbc4fi8LQ0gNxbpQ",
      "type": "text",
      "x": 1209.4605508437794,
      "y": 5726.229172909882,
      "width": 326.5798034667969,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6u",
      "roundness": null,
      "seed": 469984751,
      "version": 228,
      "versionNonce": 1813344705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791398511756,
      "created": 1791398371620,
      "link": null,
      "locked": false,
      "text": "p(a) = (2*1/6)*6/10 + (1/6)*4/5 \np(a) = 1/3",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "p(a) = (2*1/6)*6/10 + (1/6)*4/5 \np(a) = 1/3",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2PE2qti_FptpZOlEqJpgN",
      "type": "text",
      "x": 448.9807842131953,
      "y": 6210.781657097881,
      "width": 590.8717651367188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b70",
      "roundness": null,
      "seed": 222292078,
      "version": 717,
      "versionNonce": 493743659,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791507639463,
      "created": 1791398831412,
      "link": null,
      "locked": false,
      "text": "H(B/a) = 6/10·log₂(1/(6/10)) + 4/10·log₂(1/(4/10)) = 0.971 bit",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/a) = 6/10·log₂(1/(6/10)) + 4/10·log₂(1/(4/10)) = 0.971 bit",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pRIzDfMlFWdylE6tf0fhk",
      "type": "text",
      "x": 416.62402671697896,
      "y": 6101.342764667983,
      "width": 626.681396484375,
      "height": 57.25106635994658,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b71",
      "roundness": null,
      "seed": 88157806,
      "version": 376,
      "versionNonce": 726638085,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Om9jOYXRcwUtxuDZIfwbG",
          "type": "arrow"
        }
      ],
      "updated": 1791507639463,
      "created": 1791398980798,
      "link": null,
      "locked": false,
      "text": "\nH(B/aᵢ) = Σⱼ p(bⱼ/aᵢ) · log₂(1/p(bⱼ/aᵢ)). -> se miran las filas",
      "fontSize": 22.900426543978632,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nH(B/aᵢ) = Σⱼ p(bⱼ/aᵢ) · log₂(1/p(bⱼ/aᵢ)). -> se miran las filas",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "y0zh4csA4o7OMXKowyszM",
      "type": "text",
      "x": 415.5605986248526,
      "y": 6065.449986186248,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b74",
      "roundness": null,
      "seed": 1330489906,
      "version": 208,
      "versionNonce": 1293568626,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791399459183,
      "created": 1791399074033,
      "link": null,
      "locked": false,
      "text": "Para calcular la entropia de una fuente de markov se calcula la entropia individual\nde cada simbolo de la matriz de transicion",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para calcular la entropia de una fuente de markov se calcula la entropia individual de cada simbolo de la matriz de transicion",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qiHxoWgniZX6HUsQmIq4J",
      "type": "text",
      "x": 407.1181820619669,
      "y": 6444.507569623364,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b75",
      "roundness": null,
      "seed": 1806142322,
      "version": 654,
      "versionNonce": 304856494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791399454653,
      "created": 1791399111929,
      "link": null,
      "locked": false,
      "text": "Despues de obtener cada entropia individual se suma todo usando la formula de\nla entropia de markov en general",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Despues de obtener cada entropia individual se suma todo usando la formula de la entropia de markov en general",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
