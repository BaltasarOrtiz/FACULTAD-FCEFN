    {
      "id": "vIlvGJUXCRtK3wm_aMZ3s",
      "type": "text",
      "x": 406.43534413026447,
      "y": 1663.5748501624032,
      "width": 1061,
      "height": 428.9999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
