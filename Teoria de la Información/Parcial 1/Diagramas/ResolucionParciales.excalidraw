      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nH(B/aᵢ) = Σⱼ p(bⱼ/aᵢ) · log₂(1/p(bⱼ/aᵢ)). -> se miran las filas",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sE32_zJCILBjaLwM3Rk3-",
      "type": "text",
      "x": 5282.190362397616,
      "y": 2003.9934325053569,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
