      "link": null,
      "locked": false,
      "text": "H(B/u) = 4/5·log₂(1/(4/5)) + 1/5·log₂(1/(1/5)) = 0,722",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/u) = 4/5·log₂(1/(4/5)) + 1/5·log₂(1/(1/5)) = 0,722",
