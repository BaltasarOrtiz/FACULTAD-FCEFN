      "isDeleted": false,
      "boundElements": [],
      "updated": 1791507639463,
      "created": 1791399216508,
      "link": null,
      "locked": false,
      "text": "H(B/A) = Σ p(aᵢ) · H(B/aᵢ)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
