      "text": "H(B/a) = 2*(2/7 * log2(7/2)) + 3*(1/7 * log2(7/1)) = 2,2359",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/a) = 2*(2/7 * log2(7/2)) + 3*(1/7 * log2(7/1)) = 2,2359",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
