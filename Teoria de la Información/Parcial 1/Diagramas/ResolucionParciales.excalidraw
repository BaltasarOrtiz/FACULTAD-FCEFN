      "type": "text",
      "x": 417.332647837399,
      "y": 3710.121447241805,
      "width": 327.7767013116561,
      "height": 41.0621584114315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
