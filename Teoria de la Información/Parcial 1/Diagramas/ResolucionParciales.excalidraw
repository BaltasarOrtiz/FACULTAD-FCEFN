      "versionNonce": 391150789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791509236763,
      "created": 1791507657378,
      "link": null,
      "locked": false,
      "text": "Para calcular la entropia de una fuente de markov se calcula la entropia individual\nde cada simbolo de la matriz de transicion",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para calcular la entropia de una fuente de markov se calcula la entropia individual de cada simbolo de la matriz de transicion",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wi-80vWnMak0qdoLSNQAP",
      "type": "text",
      "x": 5273.74794583473,
      "y": 2383.0510159424734,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
