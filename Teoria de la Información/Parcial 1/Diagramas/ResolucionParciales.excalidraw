      "seed": 246617227,
      "version": 813,
      "versionNonce": 806263845,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791509236763,
      "created": 1791507657378,
      "link": null,
      "locked": false,
      "text": "Despues de obtener cada entropia individual se suma todo usando la formula de\nla entropia de markov en general",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Despues de obtener cada entropia individual se suma todo usando la formula de la entropia de markov en general",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
