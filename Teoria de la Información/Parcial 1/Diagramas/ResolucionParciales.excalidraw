    },
    {
      "id": "VXmI79uj6OZFH1M5-cCRO",
      "type": "text",
      "x": 20094.64560875638,
      "y": 2387.8751124887012,
      "width": 3650.196533203125,
      "height": 165,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbF",
      "roundness": null,
      "seed": 1822585081,
      "version": 247,
      "versionNonce": 357088985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791836562745,
      "created": 1791836378551,
      "link": null,
      "locked": false,
      "text": "BSC: C = 1 − H(p) = 1 + ( p log2 p + (1 − p) log2 (1 − p) )",
      "fontSize": 132,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BSC: C = 1 − H(p) = 1 + ( p log2 p + (1 − p) log2 (1 − p) )",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "97dr8iddkcQr4cBFU-xuU",
      "type": "text",
      "x": 20152.85349328754,
      "y": 2633.500000000002,
      "width": 4167.3720703125,
      "height": 165,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbG",
      "roundness": null,
      "seed": 1132495231,
      "version": 375,
