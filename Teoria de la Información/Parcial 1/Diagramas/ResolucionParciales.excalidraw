      "text": "L = Σ pᵢ·lᵢ = 2 * (1/3 * 1) + 2 * (1/9 * 2) + 3 * (1/27 * 3) = 1.44 bits/simbolo",
      "fontSize": 74.00000000000003,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L = Σ pᵢ·lᵢ = 2 * (1/3 * 1) + 2 * (1/9 * 2) + 3 * (1/27 * 3) = 1.44 bits/simbolo",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PNO2SjK0vRR9rJYsAvttW",
      "type": "text",
      "x": 13220.813576295364,
