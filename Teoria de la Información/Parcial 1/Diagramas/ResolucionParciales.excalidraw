      "isDeleted": false,
      "boundElements": [],
      "updated": 1791382762597,
      "created": 1791382502446,
      "link": null,
      "locked": false,
      "text": "Grado de compresión",
      "fontSize": 32.84972672914519,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Grado de compresión",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c10Z4pHvW0p5u3lL9LZlT",
      "type": "text",
      "x": 418.7999065029826,
      "y": 3769.0290063077164,
      "width": 770.6597900390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4L",
      "roundness": null,
      "seed": 1492296882,
      "version": 173,
      "versionNonce": 523186546,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791382760427,
      "created": 1791382502446,
      "link": null,
      "locked": false,
      "text": "Código de longitud fija: 5 símbolos → 2³ = 8 → 3 bits/símbolo; \ntotal 3·30 = 90 bits.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Código de longitud fija: 5 símbolos → 2³ = 8 → 3 bits/símbolo; \ntotal 3·30 = 90 bits.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sim4DgIrRa6MQpMZRmzAu",
      "type": "text",
      "x": 420.2540569630429,
      "y": 3836.5246802330507,
      "width": 778.4595947265625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4M",
      "roundness": null,
      "seed": 1618786158,
      "version": 207,
      "versionNonce": 216806194,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791382760427,
      "created": 1791382502446,
      "link": null,
      "locked": false,
      "text": "Lsh = (10/30·2) + (5/30·3)·4 = \n        0,6667 + 2 = \n        2,6667 bits/símbolo          → (2,6667 · 30) = 80 bits.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lsh = (10/30·2) + (5/30·3)·4 = \n        0,6667 + 2 = \n        2,6667 bits/símbolo          → (2,6667 · 30) = 80 bits.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RPGkEOPqBVUIQ2p3YwTFQ",
      "type": "text",
      "x": 419.90401166932475,
      "y": 3930.440891448293,
      "width": 382.95977783203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4N",
      "roundness": null,
      "seed": 2086616690,
      "version": 279,
      "versionNonce": 2010099634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791382768754,
      "created": 1791382502446,
      "link": null,
      "locked": false,
      "text": "Compresión = (1 − 80/90)·100 = 11,11 %.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compresión = (1 − 80/90)·100 = 11,11 %.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
