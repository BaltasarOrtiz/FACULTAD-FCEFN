      "isDeleted": false,
      "boundElements": [],
      "updated": 1791510194941,
      "created": 1791399571501,
      "link": null,
      "locked": false,
      "text": "H(B/A) = p(a)·H(B/a) + p(e)·H(B/e) + p(i)·H(B/i) + p(o)·H(B/o) + p(u)·H(B/u)\n\nH(B/A) = 1/3 * 0.971 + 0 + 0 + 0 + 1/6 * 0.722 = 0.444 bit/simbolo\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/A) = p(a)·H(B/a) + p(e)·H(B/e) + p(i)·H(B/i) + p(o)·H(B/o) + p(u)·H(B/u)\n\nH(B/A) = 1/3 * 0.971 + 0 + 0 + 0 + 1/6 * 0.722 = 0.444 bit/simbolo\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
