      "isDeleted": false,
      "boundElements": [],
      "updated": 1791507639463,
      "created": 1791399221702,
      "link": null,
      "locked": false,
      "text": "H(B/e) = 5/5·log₂(1/(5/5)) = 0",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/e) = 5/5·log₂(1/(5/5)) = 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VbwWEZRxNLYyYJew4Hmpg",
