      "boundElements": [],
      "updated": 1791507639463,
      "created": 1791399223135,
      "link": null,
      "locked": false,
      "text": "H(B/i) = 0 ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(B/i) = 0 ",
