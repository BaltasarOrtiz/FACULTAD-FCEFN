      "isDeleted": false,
      "boundElements": [],
      "updated": 1794919232538,
      "created": 1794919163980,
      "link": null,
      "locked": false,
      "text": "1) Paso",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Paso",
