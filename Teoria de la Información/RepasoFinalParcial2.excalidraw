      "text": "φ(n) = (p-1) * (q-1) = (17-1) * (23-1) = 352",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "φ(n) = (p-1) * (q-1) = (17-1) * (23-1) = 352",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
