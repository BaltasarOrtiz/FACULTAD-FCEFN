      "containerId": null,
      "originalText": "Firma + confidencialidad:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SOcBJ6GpGKv0RnXQACCns",
      "type": "text",
      "x": 707.620201579868,
      "y": 1706.7985189919266,
      "width": 755.6593017578125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1714287045,
      "version": 190,
      "versionNonce": 2128939819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794920682748,
      "created": 1794920673021,
      "link": null,
      "locked": false,
      "text": "Emisor: primero firma con su privada, después cifra con la pública del receptor.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Emisor: primero firma con su privada, después cifra con la pública del receptor.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Gpfvb5v8iM5l0iexnha1e",
      "type": "text",
      "x": 703.9457801483843,
      "y": 1743.1977281199427,
      "width": 816.1793212890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1362540811,
      "version": 200,
      "versionNonce": 652337963,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794920681429,
      "created": 1794920673021,
      "link": null,
      "locked": false,
      "text": "Receptor: primero descifra con su privada, después verifica con la pública del emisor.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Receptor: primero descifra con su privada, después verifica con la pública del emisor.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XYAfjkhfK6eMzquM6bo4d",
      "type": "text",
      "x": 641.1996971468686,
      "y": 1795.1007378824193,
      "width": 964.0594482421875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 225800485,
      "version": 359,
      "versionNonce": 1597124869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794920691787,
      "created": 1794920673021,
      "link": null,
      "locked": false,
      "text": "Cada clave cumple un rol distinto. La del receptor da confidencialidad (solo él lee). La del emisor da\nautenticidad (solo él pudo firmar). Si solo piden firma, alcanza con la privada/pública del emisor.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cada clave cumple un rol distinto. La del receptor da confidencialidad (solo él lee). La del emisor da autenticidad (solo él pudo firmar). Si solo piden firma, alcanza con la privada/pública del emisor.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
