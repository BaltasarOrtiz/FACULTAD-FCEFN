      "updated": 1794919250937,
      "created": 1794919118714,
      "link": null,
      "locked": false,
      "text": "A partir de p y q, se calcula φ(n) = (p-1) * (q-1) ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A partir de p y q, se calcula φ(n) = (p-1) * (q-1) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0WajTN1Jw6BdauBMsInyU",
