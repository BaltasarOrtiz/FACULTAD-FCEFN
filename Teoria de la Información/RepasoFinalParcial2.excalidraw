      "updated": 1794919386637,
      "created": 1794919192025,
      "link": null,
      "locked": false,
      "text": "Suponiendo que p=17 y q=23 entonces n = p*q = 391",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suponiendo que p=17 y q=23 entonces n = p*q = 391",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
