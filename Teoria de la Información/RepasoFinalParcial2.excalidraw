      "seed": 1580671271,
      "version": 528,
      "versionNonce": 314329543,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794922909876,
      "created": 1794922891134,
      "link": null,
      "locked": false,
      "text": "B) Los métodos antes vistos, ¿modifican la entropía de orden cero?",
      "fontSize": 17.079370843016466,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B) Los métodos antes vistos, ¿modifican la entropía de orden cero?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "h-24gRbpZFCzIvLDgye3m",
      "type": "text",
      "x": 1288.4744336162096,
      "y": 2165.4003556438497,
      "width": 634.2077854810744,
      "height": 42.69842710754117,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7N",
      "roundness": null,
      "seed": 1428579399,
      "version": 527,
      "versionNonce": 1547532519,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794922909876,
      "created": 1794922891134,
      "link": null,
      "locked": false,
      "text": "C) En la fuente cifrada, y en cada paso de descifrado, calcule la entropía de\norden cero para comprobar lo manifestado por usted en el punto anterior.",
      "fontSize": 17.07937084301647,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C) En la fuente cifrada, y en cada paso de descifrado, calcule la entropía de orden cero para comprobar lo manifestado por usted en el punto anterior.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
